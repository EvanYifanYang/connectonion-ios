flowchart LR
    UI["SwiftUI screens<br/>Agent list, editor, chat"]
    VM["ViewModels<br/>state, validation, orchestration"]
    SD["SwiftData<br/>agent profiles + conversations"]
    KC["Keychain<br/>private identity / credentials"]
    Client["ConnectOnionClient<br/>ProtocolCodec"]
    Directory["AgentDirectoryService<br/>route resolution"]
    Direct["Direct endpoint<br/>ws://.../ws"]
    Relay["Relay fallback<br/>wss://oo.openonion.ai/ws/input"]
    Agent["Hosted ConnectOnion agent<br/>host(agent)"]

    UI --> VM
    VM --> SD
    VM --> KC
    VM --> Client
    Client -->|"signed CONNECT + INPUT"| Directory
    Directory -->|"prefer if reachable"| Direct
    Directory -->|"fallback"| Relay
    Direct --> Agent
    Relay --> Agent
    Agent -->|"CONNECTED / events / OUTPUT"| Client
    Client --> VM
    VM --> UI
